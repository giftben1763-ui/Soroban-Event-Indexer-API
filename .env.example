# Soroban RPC endpoint. Testnet by default; swap for mainnet or a local node.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The contract whose events you want indexed. Required.
CONTRACT_ID=CBQHNAXSI55GX2GN6D67GK7BHVPSLJUGZQEU7WJ5LKR5PNUCGLIMAO4K

# Where the SQLite file lives. Both the worker and the API process must
# point at the same path.
DB_PATH=./data/indexer.sqlite

# Worker tuning.
POLL_INTERVAL_MS=5000
MAX_LEDGERS_PER_REQUEST=2000
PAGE_LIMIT=200
RETENTION_WINDOW_LEDGERS=17280
START_LEDGER=0

# Which topic index holds the human-readable event name (used for the
# event_type column and ?type= filter). 0 = topics[0] is the event name
# (SEP-41 token convention: "transfer", "mint", ...). Some contracts prefix
# topics with a contract name instead, e.g. Soroswap's pair contract emits
# topics = ("SoroswapPair", "swap", ...) — set this to 1 for those.
EVENT_TYPE_TOPIC_INDEX=0

# API tuning.
API_PORT=3000
API_MAX_PAGE_SIZE=200
